# LINE Messaging API 設定
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 統一平台對外公開網址 (結尾不帶斜線)
BASE_URL=https://your-magic-platform.onrender.com

# 超級管理員 (平台創辦人) LINE User ID
ADMIN_USER_ID=U1234567890abcdef1234567890abcdef

# LIFF 入口 (Endpoint 設為 BASE_URL/liff-router)
LIFF_URL=https://liff.line.me/your-liff-id

# Redis 連線字串 (用於多租戶即時狀態、TTL 自動鎖與免費體驗配額)
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# Google Gemini API 金鑰 (用於撲克牌四角偵測)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Firestore 憑證 (填入服務帳號 JSON 完整字串或檔案路徑；留空則自動使用 Redis 訂閱引擎)
FIREBASE_CREDENTIALS_JSON=

# 平台授權 Token 加密鹽值 (請隨意設定一串安全亂數)
APP_SECRET_SALT=magic-saas-secret-2026
