# LINE Messaging API 設定
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 服務對外公開網址 (例如使用 ngrok 或正式主機網址，結尾不帶斜線)
BASE_URL=https://your-domain.ngrok-free.app

# 魔術師 (管理員) 的 LINE User ID (接收每日開通回報與下一張迫牌秘密推播)
ADMIN_USER_ID=U1234567890abcdef1234567890abcdef

# LIFF 應用程式 URL (填入 line://app/xxxxxx-xxxxxx 或留空預設為 BASE_URL/magic-app)
LIFF_URL=https://liff.line.me/your-liff-id

# Redis 連線字串 (預設本地 Redis)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API Key (用於影像中撲克牌背精準四角偵測；若未設定則自動啟用 OpenCV 邊界辨識備援)
GEMINI_API_KEY=your_gemini_api_key_here

